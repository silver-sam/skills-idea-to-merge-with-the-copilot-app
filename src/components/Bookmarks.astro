---
import { formatBookmark } from '../lib/bookmarks.js';
---
<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="url"
      spellcheck="false"
      placeholder="example.com"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p class="hint">Paste a URL with or without <code>https://</code>. Mona will make a short slug for it.</p>
<p id="bookmark-status" class="status" role="status" aria-live="polite"></p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite"></ul>

<style is:global>
  #add-bookmark {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: end;
    margin: 1.75rem 0 0.5rem;
    padding: 1.1rem;
    border: 1px solid var(--border);
    border-radius: 0.9rem;
    background: color-mix(in srgb, Canvas 94%, var(--accent) 6%);
    box-shadow: 0 12px 32px color-mix(in srgb, currentColor 7%, transparent);
  }
  #add-bookmark .field { gap: 0.45rem; }
  #add-bookmark label { font-size: 0.82rem; }
  #add-bookmark input {
    min-width: 0;
    padding: 0.72rem 0.8rem;
    border-color: color-mix(in srgb, var(--border) 80%, currentColor);
    background: Canvas;
  }
  #add-bookmark button {
    min-height: 2.8rem;
    padding-inline: 1.1rem;
    box-shadow: 0 4px 12px color-mix(in srgb, var(--accent) 28%, transparent);
  }
  .hint { margin-bottom: 1.4rem; }
  .status { min-height: 1.4em; margin: 0 0 0.65rem; font-size: 0.82rem; color: var(--muted); }
  .status[data-error="true"] { color: #b42318; }
  #list-header { margin-top: 1.5rem; }
  .list-title { font-size: 1.05rem; }
  #bookmark-list { gap: 0.65rem; }
  #bookmark-list .bookmark {
    gap: 0.55rem;
    padding: 0.8rem 0.9rem;
    border-radius: 0.75rem;
    background: color-mix(in srgb, Canvas 97%, currentColor 3%);
    transition: border-color 140ms ease, transform 140ms ease;
  }
  #bookmark-list .bookmark:hover {
    border-color: color-mix(in srgb, var(--accent) 55%, var(--border));
    transform: translateY(-1px);
  }
  #bookmark-list .url { color: inherit; text-decoration-color: color-mix(in srgb, currentColor 35%, transparent); }
  #bookmark-list .url:hover { color: var(--accent); }
  #bookmark-list .separator { color: var(--muted); white-space: pre; }
  #bookmark-list .slug {
    font-family: var(--font-body);
    font-size: 0.82rem;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }
  #bookmark-list .copy { margin-left: auto; }
  #empty-state { padding: 1.4rem; }
  @media (max-width: 28rem) {
    #add-bookmark button { width: 100%; }
    #bookmark-list .copy { margin-left: 0; }
  }
</style>

<script>
  import { createBookmarkSlug, loadBookmarks, normalizeUrl } from '../lib/bookmarks.js';

  const storageKey = 'mona-bookmarks';
  const form = document.getElementById('add-bookmark');
  const urlInput = document.getElementById('url');
  const list = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const status = document.getElementById('bookmark-status');
  const clearButton = document.getElementById('clear-all');

  let bookmarks = [];

  function showStatus(message, isError = false) {
    status.textContent = message;
    status.dataset.error = String(isError);
  }

  function saveBookmarks(nextBookmarks) {
    try {
      window.localStorage.setItem(storageKey, JSON.stringify(nextBookmarks));
      return true;
    } catch {
      showStatus('Could not save bookmarks in this browser.', true);
      return false;
    }
  }

  function renderBookmarks() {
    list.replaceChildren();
    emptyState.hidden = bookmarks.length > 0;
    listHeader.hidden = bookmarks.length === 0;

    for (const bookmark of bookmarks) {
      const item = document.createElement('li');
      item.className = 'bookmark';

      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = bookmark.url;

      const separator = document.createElement('span');
      separator.className = 'separator';
      separator.textContent = ' :: ';
      separator.setAttribute('aria-hidden', 'true');

      const slug = document.createElement('code');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;
      slug.setAttribute('aria-label', formatBookmark(bookmark));

      const copyButton = document.createElement('button');
      copyButton.className = 'copy';
      copyButton.type = 'button';
      copyButton.textContent = 'Copy';
      copyButton.setAttribute('aria-label', `Copy ${bookmark.slug}`);
      copyButton.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(bookmark.slug);
          showStatus(`Copied ${bookmark.slug}.`);
        } catch {
          showStatus('Clipboard access is unavailable in this browser.', true);
        }
      });

      item.append(link, separator, slug, copyButton);
      list.append(item);
    }
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    try {
      const url = normalizeUrl(urlInput.value);
      const nextBookmarks = [...bookmarks, { url, slug: createBookmarkSlug(bookmarks) }];
      if (!saveBookmarks(nextBookmarks)) return;
      bookmarks = nextBookmarks;
      renderBookmarks();
      form.reset();
      showStatus('Bookmark saved.');
    } catch {
      showStatus('Enter a valid web URL to save.', true);
    }
  });

  clearButton?.addEventListener('click', () => {
    if (!window.confirm('Clear all saved bookmarks?')) return;
    try {
      window.localStorage.removeItem(storageKey);
      bookmarks = [];
      renderBookmarks();
      showStatus('All bookmarks cleared.');
    } catch {
      showStatus('Could not clear bookmarks in this browser.', true);
    }
  });

  try {
    bookmarks = loadBookmarks(window.localStorage.getItem(storageKey));
  } catch {
    bookmarks = [];
  }
  renderBookmarks();
</script>
